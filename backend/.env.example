# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env real a un repositorio.

# Servidor
PORT=4000
NODE_ENV=development

# Interfaz de red donde escucha el backend.
# 0.0.0.0 = todas las interfaces (necesario para acceder desde una VM u otra maquina de la red).
# 127.0.0.1 = solo esta maquina.
HOST=0.0.0.0

# Origenes permitidos del frontend, para CORS (sin comodin).
# Admite una lista separada por comas, por ejemplo para permitir a la vez el
# acceso local (localhost) y desde una VM u otra maquina (la IP LAN real de
# este host, porque esa maquina no puede resolver "localhost" a este host).
FRONTEND_ORIGIN=http://localhost:5173,http://192.168.0.225:5173

# Base de datos MySQL (ya existente, no se modifica su esquema)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_NAME=recetario_db

# JWT
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# Cookies
COOKIE_SECURE=false
